# ========================================================
# ArthaNexus AI Environment Configuration Template
# DO NOT COMMIT SECRETS. Copy this file to .env locally.
# ========================================================

# Deployment Environment: development | staging | production
NODE_ENV=development
APP_URL=http://localhost:3000

# Strict Cost Control & Billing Guard
ALLOW_PAID_SERVICES=false
ENABLE_AI_INFERENCE=true
ENABLE_BACKGROUND_CRON=true
MAX_DAILY_AI_REQUESTS=1000

# AWS Cloud Infrastructure & LocalStack Emulation
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=placeholder_aws_access_key
AWS_SECRET_ACCESS_KEY=placeholder_aws_secret_key
# Optional: LocalStack endpoint for local testing (e.g. http://localhost:4566)
LOCALSTACK_HOSTNAME=localhost
AWS_ENDPOINT_URL=

# GitHub Actions CI/CD Integration
GITHUB_TOKEN=placeholder_github_personal_access_token
GITHUB_REPOSITORY=ArthaNexus/arthanexus-ai

# Vercel Production & Preview Deployment Integration
VERCEL_TOKEN=placeholder_vercel_api_token
VERCEL_PROJECT_ID=prj_arthanexus_terminal

# Cloudflare Primary Infrastructure (Zero-Cost Plan)
CLOUDFLARE_ACCOUNT_ID=placeholder_cf_account_id
CLOUDFLARE_API_TOKEN=placeholder_cf_api_token
D1_DATABASE_ID=placeholder_d1_database_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_key
R2_BUCKET_NAME=arthanexus-bronze-raw

# AI Provider Gateway (Optional Free Keys - system gracefully falls back to deterministic engine)
# 1. Google Gemini API (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=placeholder_gemini_api_key

# 2. Groq Cloud (Free Developer tier from https://console.groq.com/)
GROQ_API_KEY=placeholder_groq_api_key

# 3. Mistral Developer Platform (Optional fallback)
MISTRAL_API_KEY=placeholder_mistral_api_key

# Public Indian Data Connectors
# data.gov.in Free API Key (Optional, from https://data.gov.in/)
DATA_GOV_IN_API_KEY=placeholder_data_gov_in_api_key

# Multi-Scheduler Shared HMAC Secret for Watchdog reconciliation
CRON_DISPATCH_SECRET=placeholder_super_secret_hmac_key_for_cron_watchdog
